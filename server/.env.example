# Copy this file to .env and fill in your real values. Never commit .env.

# ---------------------------------------------------------------------------
# Database — a free Postgres instance from Neon (neon.tech) or Supabase
# (supabase.com) works well. Copy the connection string they give you.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_R1pYm2wQnXvy@ep-orange-block-b3e7h3m7-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ---------------------------------------------------------------------------
# JWT — used to sign login sessions. Generate a random one, e.g. run this
# once in a terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string

# ---------------------------------------------------------------------------
# Brevo — for welcome emails, OTP codes, password resets, and order status
# updates. Sent over HTTPS, not SMTP — this matters because Render's free
# tier blocks outbound SMTP entirely, but plain HTTPS always works. Free
# account, no credit card, 300 emails/day. See server/README.md for setup.
# ---------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=youraddress@gmail.com
SENDER_NAME=Priyasa Fashion

# Used to build links inside emails (e.g. the password reset link).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Initial admin account — used ONLY by `npm run seed-admin` to create your
# admin login. Change ADMIN_PASSWORD to something only you know, then run
# `npm run seed-admin` once. These two lines aren't read by the server itself
# afterward — the account lives in the database from then on.
# ---------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@priyasafashion.com
ADMIN_PASSWORD=change_this_before_seeding

# ---------------------------------------------------------------------------
# Razorpay — from Dashboard → Settings → API Keys.
# Use rzp_test_ keys while testing, rzp_live_ keys once you go live.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Port this server listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call this backend.
ALLOWED_ORIGINS=http://localhost:5173,https://yourshop.vercel.app
